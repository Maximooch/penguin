version: '3.9'

services:
  # Penguin Web API
  penguin:
    build:
      context: .
      dockerfile: docker/Dockerfile.web
      args:
        INSTALL_MODE: local
    ports:
      - "127.0.0.1:8000:8000"
    environment:
      - HOST=0.0.0.0
      - PORT=8000
      - PENGUIN_DEFAULT_MODEL=deepseek/deepseek-v3.2-exp
      - PENGUIN_DEFAULT_PROVIDER=openrouter
      - PENGUIN_CLIENT_PREFERENCE=openrouter
      - PENGUIN_WORKSPACE=/workspace
    env_file:
      - .env
    volumes:
      - ./workspace:/workspace
      - ./penguin:/app/penguin:ro
    networks:
      - penguin-net
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:8000/api/v1/health"]
      interval: 10s
      timeout: 5s
      retries: 3
    restart: unless-stopped

  # Traefik Gateway (local)
  gateway:
    image: traefik:v3.0
    ports:
      - "127.0.0.1:80:80"
    volumes:
      - ./deploy/traefik/traefik.yml:/etc/traefik/traefik.yml:ro
      - ./deploy/traefik/dynamic.yml:/etc/traefik/dynamic.yml:ro
    networks:
      - penguin-net

  # Redis (for future: caching, sessions)
  redis:
    image: redis:7-alpine
    networks:
      - penguin-net
    volumes:
      - redis-data:/data
    command: redis-server --appendonly yes
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 3

  # PostgreSQL (for future: projects DB, if needed)
  postgres:
    image: postgres:16-alpine
    environment:
      - POSTGRES_USER=penguin
      - POSTGRES_PASSWORD=penguin
      - POSTGRES_DB=penguin
    networks:
      - penguin-net
    volumes:
      - postgres-data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U penguin"]
      interval: 10s
      timeout: 5s
      retries: 3

  # Jaeger (tracing, optional)
  jaeger:
    image: jaegertracing/all-in-one:latest
    environment:
      - COLLECTOR_OTLP_ENABLED=true
    networks:
      - penguin-net

networks:
  penguin-net:
    driver: bridge

volumes:
  redis-data:
  postgres-data:
